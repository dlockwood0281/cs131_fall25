\f0\fs24 \cf0 #include <iostream>\
#include <iomanip>\
\
int main() \{\
    double pitchRange, originalBpm, targetBpm;\
\
    // 1. Get User Input\
    std::cout << "Enter turntable pitch range (e.g., 8, 16, 50): ";\
    std::cin >> pitchRange;\
\
    std::cout << "Enter the original BPM of the record: ";\
    std::cin >> originalBpm;\
\
    std::cout << "Enter the target BPM you want to match: ";\
    std::cin >> targetBpm;\
\
    // 2. Calculate Percent Change\
    // Formula: ((Target - Original) / Original) * 100\
    double difference = targetBpm - originalBpm;\
    double percentChange = (difference / originalBpm) * 100.0;\
\
    // 3. Determine Absolute Value for Range Check\
    // (Manual calculation since <cmath> is not included)\
    double absChange = (percentChange < 0) ? -percentChange : percentChange;\
\
    // 4. Output Results\
    std::cout << std::fixed << std::setprecision(2); // Set output to 2 decimal places\
    std::cout << "\\n-----------------------------" << std::endl;\
    std::cout << "Required Adjustment: " << (percentChange > 0 ? "+" : "") << percentChange << "%" << std::endl;\
\
    if (absChange <= pitchRange) \{\
        std::cout << "Status: MATCH POSSIBLE (Within +/-" << (int)pitchRange << "% range)" << std::endl;\
    \} else \{\
        std::cout << "Status: NOT POSSIBLE (Exceeds +/-" << (int)pitchRange << "% range)" << std::endl;\
    \}\
    std::cout << "-----------------------------" << std::endl;\
\
    return 0;\
\}}