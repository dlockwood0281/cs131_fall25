\f0\fs24 \cf0 #include <iostream>\
#include <iomanip>\
\
using namespace std;\
\
int main() \{\
    double pitchRange;   // turntable pitch range in percent (e.g., 8 or 16)\
    double originalBPM;  // BPM of the record you are adjusting\
    double targetBPM;    // BPM you want to match\
\
    cout << "Enter turntable pitch range (percent, e.g. 8 or 16): ";\
    cin >> pitchRange;\
\
    if (pitchRange <= 0) \{\
        cout << "Pitch range must be a positive number." << endl;\
        return 0;\
    \}\
\
    cout << "Enter original BPM: ";\
    cin >> originalBPM;\
\
    if (originalBPM <= 0) \{\
        cout << "Original BPM must be a positive number." << endl;\
        return 0;\
    \}\
\
    cout << "Enter target BPM: ";\
    cin >> targetBPM;\
\
    // Calculate percent change needed to get from originalBPM to targetBPM\
    double percentChange = (targetBPM - originalBPM) / originalBPM * 100.0;\
\
    cout << fixed << setprecision(2);\
    cout << "\\nRequired pitch adjustment: " << percentChange << "%";\
\
    // Check if the required change is within +/- pitchRange\
    if (percentChange >= -pitchRange && percentChange <= pitchRange) \{\
        cout << "\\nResult: This adjustment IS possible within your +/-"\
             << pitchRange << "% pitch range." << endl;\
    \} else \{\
        cout << "\\nResult: This adjustment is NOT possible with a +/-"\
             << pitchRange << "% pitch range." << endl;\
    \}\
\
    return 0;\
\}\
}